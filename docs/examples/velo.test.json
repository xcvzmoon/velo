{
  "version": 1,
  "config": {
    "url": "{{baseUrl}}/items/{{itemId}}",
    "method": "POST",
    "headers": [{ "name": "Accept", "value": "application/json" }],
    "query": [
      { "name": "tag", "value": "first" },
      { "name": "tag", "value": "second" }
    ],
    "body": { "kind": "json", "value": "{\"label\":\"{{label}}\"}" },
    "auth": { "kind": "bearer", "token": "{{token}}" },
    "protocol": "auto",
    "max_redirects": 0,
    "workload": { "kind": "constant", "vus": 1, "duration_ms": 10000 },
    "timeout_ms": 30000,
    "pacing_ms": 0,
    "grace_ms": 5000,
    "thresholds": [],
    "assertions": [{ "id": "status", "rule": { "kind": "status", "allowed": [200, 201] } }],
    "inspection": { "body_bytes": 16384, "sample_count": 16, "sample_bytes": 8192 },
    "budget": { "max_vus": 256, "max_request_bytes": 8388608 }
  },
  "variables": {
    "baseUrl": "http://127.0.0.1:8080",
    "itemId": "example",
    "label": "local preview",
    "token": "{{secret:local-api-token}}"
  },
  "environments": {
    "staging": {
      "baseUrl": "https://staging.example.com",
      "token": "{{secret:staging-api-token}}"
    }
  }
}
