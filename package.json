{
  "name": "velo",
  "description": "A lightweight, native API load-testing studio powered by Rust",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tauri build",
    "dev": "tauri-nuxt-dev",
    "postinstall": "pnpm nuxt:postinstall",
    "typecheck": "pnpm nuxt:typecheck",
    "fmt": "run-p oxc:fmt cargo:fmt",
    "lint": "run-p oxc:lint cargo:lint",
    "check": "run-p oxc:check cargo:check",
    "test": "run-s cargo:test vitest:test",
    "validate": "run-s fmt lint check typecheck test",
    "release": "genbumppush --yes",
    "oxc:fmt": "oxfmt",
    "oxc:check": "oxfmt --check",
    "oxc:lint": "oxlint",
    "cargo:fmt": "cargo fmt --all",
    "cargo:check": "cargo fmt --all -- --check",
    "cargo:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "cargo:clean": "cargo clean",
    "cargo:clean:release": "cargo clean --release",
    "cargo:test": "cargo test --workspace",
    "nuxt:build": "nuxt build",
    "nuxt:dev": "nuxt dev",
    "nuxt:generate": "nuxt generate",
    "nuxt:preview": "nuxt preview",
    "nuxt:postinstall": "nuxt prepare",
    "nuxt:typecheck": "nuxt typecheck",
    "vitest:test": "vitest run",
    "bindings:generate": "node scripts/bindings.ts",
    "bindings:check": "node scripts/bindings.ts --check",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@formisch/vue": "^1.2.0",
    "@nuxt/ui": "4.12.0",
    "@tauri-apps/api": "^2.12.4",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "nuxt": "^4.6.4",
    "papaparse": "5.5.3",
    "uplot": "^1.6.32",
    "valibot": "^1.5.0",
    "vue": "^3.5.44",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@golar/vue": "^0.1.11",
    "@iconify-json/hugeicons": "^1.2.35",
    "@iconify-json/lucide": "^1.2.152",
    "@oxlint/plugins": "^1.91.0",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/papaparse": "5.3.16",
    "genbumppush": "^0.0.10",
    "golar": "^0.1.11",
    "lefthook": "^2.2.2",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sirv-cli": "^3.0.1",
    "tailwindcss": "^4.3.4",
    "tauri-nuxt-dev": "^0.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
