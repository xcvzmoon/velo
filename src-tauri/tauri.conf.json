{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Velo",
  "version": "0.0.0",
  "identifier": "com.velo.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:65432",
    "beforeDevCommand": "pnpm nuxt:dev --port 65432",
    "beforeBuildCommand": "pnpm nuxt:generate"
  },
  "app": {
    "windows": [
      {
        "title": "Velo",
        "minWidth": 1000,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 13,
          "y": 21
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
